set -euo pipefail

# --- host diagnostics (stderr) ---
nvidia-smi >&2 || true
df -hT >&2
echo "Hostname: $(hostname -f)" >&2
hostname -I >&2
apptainer instance list -a -j >&2

# --- scratch space for the local SIF copy ---
TMP_BASE_DIR="${TMP_BASE_DIR:-/scratch/slurm_tmpdir/${SLURM_JOB_ID:-}/}"
mkdir -p "$TMP_BASE_DIR"

# Slurm does not always enforce memory limits; cap virtual memory ourselves
ulimit -v 100000000 # 100GB

# Unique Apptainer instance name (no host temp dir needed with --writable-tmpfs)
INSTANCE_NAME="sandbox-$(mktemp -u XXXXXXXXXX)"
KG_IP=$(hostname -i)

cleanup() {
    echo "Stopping instance $INSTANCE_NAME..." >&2
    apptainer instance stop "$INSTANCE_NAME" 2>/dev/null || true
    exit 0
}
trap cleanup SIGINT SIGTERM EXIT

# --- image version and optional read-only overlays (set by apptainer_jupyter_server.py) ---
SUPERIMAGE_VERSION="${SUPERIMAGE_VERSION:-2025-03-18}"
BASE_OVERLAYS="${BASE_OVERLAYS:-}"
SIF="$TMP_BASE_DIR/superimage.root.$SUPERIMAGE_VERSION.sif"

# Copy the shared SIF locally once per job (atomic rename avoids half-copied files)
if [[ ! -f "$SIF" ]]; then
    echo "Copying superimage to $SIF" >&2
    cp "${SUPERIMAGE_DIR}superimage.root.$SUPERIMAGE_VERSION.sif" "$TMP_BASE_DIR/progress.sif"
    mv "$TMP_BASE_DIR/progress.sif" "$SIF"
fi

echo "sand: launch mode = writable-tmpfs (no fakeroot)" >&2
echo "sand: instance = $INSTANCE_NAME" >&2
[[ -n "${APPTAINER_BIND:-}" ]] && echo "sand: APPTAINER_BIND=$APPTAINER_BIND" >&2
[[ -n "$BASE_OVERLAYS" ]] && echo "sand: BASE_OVERLAYS=$BASE_OVERLAYS" >&2

# APPTAINERENV_* from Python → explicit --env flags (reliable with instance run + --cleanenv)
INTERPRETER_ENV_ARGS=()
while IFS= read -r -d '' entry; do
    name="${entry%%=*}"
    value="${entry#*=}"
    [[ "$name" == APPTAINERENV_* ]] || continue
    container_name="${name#APPTAINERENV_}"
    INTERPRETER_ENV_ARGS+=(--env "${container_name}=${value}")
    echo "sand: --env ${container_name}=${value}" >&2
done < <(env -0)

# Writable-tmpfs replaces fakeroot + writable overlay (no /etc/subuid required).
apptainer instance run \
    --containall \
    --cleanenv \
    --no-home \
    --writable-tmpfs \
    --nv \
    $BASE_OVERLAYS \
    "${INTERPRETER_ENV_ARGS[@]}" \
    --env SSH_PUBLIC_KEY="${SSH_PUBLIC_KEY:-}" \
    --env KG_IP="$KG_IP" \
    --env PYTHONUNBUFFERED=1 \
    --env WANDB_DISABLED=1 \
    --env TQDM_DISABLE=1 \
    --env HF_HUB_DISABLE_PROGRESS_BARS=1 \
    --env HF_HUB_DISABLE_TELEMETRY=1 \
    --env CUDA_LAUNCH_BLOCKING=1 \
    --env TF_CPP_MIN_LOG_LEVEL=3 \
    "$SIF" \
    "$INSTANCE_NAME" \
    "$@"

echo "[DEBUG] Installing pytorch_metric_learning inside container..." >&2
apptainer exec instance://$INSTANCE_NAME bash -c '
    pip install pytorch_metric_learning peft
    pip install dotwiz
'>&2

echo "Instance started; streaming logs..." >&2
tail -f "$HOME/.apptainer/instances/logs/$(hostname)/$USER/$INSTANCE_NAME.err" >&2

